  <div class="text-frame"><figure class="table"><table class="table striped"><thead><tr><th>&nbsp;</th><th class="text-center"><p class="text-right">SSU Parc</p></th><th class="text-center"><p class="text-right">SSU Ref NR 99</p></th><th class="text-center"><p class="text-right">LSU Parc</p></th><th class="text-center"><p class="text-right">LSU Ref NR 99</p></th></tr></thead><tbody><tr><td>Minimum bases</td><td class="text-center"><p class="text-right">300</p></td><td class="text-center"><p class="text-right">1,200/900</p></td><td class="text-center"><p class="text-right">300</p></td><td class="text-center"><p class="text-right">1,900</p></td></tr><tr><td>Quality filtering</td><td class="text-center"><p class="text-right">basic</p></td><td class="text-center"><p class="text-right">strong</p></td><td class="text-center"><p class="text-right">basic</p></td><td class="text-center"><p class="text-right">strong</p></td></tr><tr><td>Guide Tree</td><td class="text-center"><p class="text-right">no</p></td><td class="text-center"><p class="text-right">yes</p></td><td class="text-center"><p class="text-right">no</p></td><td class="text-center"><p class="text-right">yes</p></td></tr><tr><td>Release date</td><td class="text-center"><p class="text-right">11.07.24</p></td><td class="text-center"><p class="text-right">11.07.24</p></td><td class="text-center"><p class="text-right">11.07.24</p></td><td class="text-center"><p class="text-right">11.07.24</p></td></tr><tr><td>Aligned rRNA sequences</td><td class="text-center"><p class="text-right">9,469,070</p></td><td class="text-center"><p class="text-right">510,495</p></td><td class="text-center"><p class="text-right">1,312,521</p></td><td class="text-center"><p class="text-right">95,279</p></td></tr></tbody></table></figure></div>


                
                    



                
                
                    



                
