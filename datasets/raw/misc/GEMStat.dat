<style data-type="vc_custom-css">.icon_boxes .nectar_icon_wrap {
	background: #305da8;
	border-radius: 100px;
	border: solid #fff 2px;
	padding: 5px;
}

.slider-header .excerpt {
	padding: 8px;
	color: #fff;
	text-align: center;
	width: 100%;
	background-color: #b2392a;
	top: -1px;
	position: absolute;
	z-index: 100;
}
.slider-header .post-header {
	display: none;
}
.slider-header {
	position: relative;
}
.slider-header .category-maintenance {
	margin: 0;
}
.slider-header .blog-recent {
	margin-bottom: 0;
	padding-bottom: 0;
}

.header_projects h1 {
	font-size: 36px;
	padding: 10px 80px;
	border-bottom: 2px solid #305da8;
	color: #305da8;
	background: url("../../wp-content/themes/salient-child/images/icon_projects.png") no-repeat scroll left bottom;
	min-height: 65px;
}
body .flex-gallery ul.flex-direction-nav {
	bottom: -40px;
	top: inherit;
}
body .flex-gallery {
	margin-bottom: 40px !important;
}
.icon_boxes {
	position: relative;
}

.icon_boxes .vc_column-inner {
	padding-bottom: 70px;
}

.icon_boxes .vc_column-inner .vc_column-inner {
	padding-bottom: 0;
}

.icon_boxes .nectar-button {
	position: absolute;
	bottom: 0;
	top: inherit;
}
.ms-3er-blog .title a {
	color: #444;
}</style><link rel="icon" href="https://gemstat.org/wp-content/uploads/2017/10/cropped-gemstat_favicon-32x32.png" sizes="32x32" />
