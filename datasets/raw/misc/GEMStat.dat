            <a href="https://gemstat.org/projects/wwqa/" target="_self" class="">
              <img decoding="async" class="img-with-animation skip-lazy" data-delay="0" height="150" width="150" data-animation="fade-in" src="https://gemstat.org/wp-content/uploads/2025/06/WWQA-Logo-new-e1751032248686-150x150.png" alt="Logo of the World Water Quality Alliance" srcset="https://gemstat.org/wp-content/uploads/2025/06/WWQA-Logo-new-e1751032248686-150x150.png 150w, https://gemstat.org/wp-content/uploads/2025/06/WWQA-Logo-new-e1751032248686-140x140.png 140w, https://gemstat.org/wp-content/uploads/2025/06/WWQA-Logo-new-e1751032248686-100x100.png 100w, https://gemstat.org/wp-content/uploads/2025/06/WWQA-Logo-new-e1751032248686-350x350.png 350w" sizes="(max-width: 150px) 100vw, 150px" />
