<style id="wp-custom-css">
/*
Füge deinen eigenen CSS-Code nach diesem Kommentar hinter dem abschließenden Schrägstrich ein. 

Klicke auf das Hilfe-Symbol oben, um mehr zu erfahren.
*/


.header_contact h1 {
	font-size: 36px;
	padding: 10px 80px;
	border-bottom: 2px solid #305da8;
    color: #305da8;
	background: url("../../wp-content/themes/salient-child/images/icon_contact.png") no-repeat scroll left bottom;
	min-height: 65px;
}

.header_gemstat h1 {
	font-size: 36px;
	padding: 10px 80px;
	border-bottom: 2px solid #305da8;
    color: #305da8;
	background: url("../../wp-content/themes/salient-child/images/icon_gemstat.png") no-repeat scroll left bottom;
	min-height: 65px;
}

.header_data h1 {
	font-size: 36px;
	padding: 10px 80px;
	border-bottom: 2px solid #305da8;
    color: #305da8;
	background: url("../../../wp-content/themes/salient-child/images/icon_data.png") no-repeat scroll left bottom;
	min-height: 65px;
}

.header_vis h1 {
	font-size: 36px;
	padding: 10px 80px;
	border-bottom: 2px solid #305da8;
    color: #305da8;
	background: url("../../wp-content/themes/salient-child/images/icon_vis.png") no-repeat scroll left bottom;
	min-height: 65px;
}

.header_news h1 {
	font-size: 36px;
	padding: 10px 80px;
	border-bottom: 2px solid #305da8;
    color: #305da8;
	background: url("../../wp-content/themes/salient-child/images/icon_news.png") no-repeat scroll left bottom;
	min-height: 65px;
}

.container.main-content li {
	margin-bottom: 30px;
}
.container.main-content li li {
	margin-bottom: unset;
}
.main-content ol ul li {
	list-style: disc;
	list-style-position: outside;
}
.main-content ol ul ol li {
	list-style: decimal;
	list-style-position: outside;
}
.tablepress tfoot th, .tablepress thead th {
    background-color: #305da8 !important;
    color: #ffffff;
}

.tabbed .wpb_tabs_nav {
	margin-bottom: 0 !important;
}

.ui-tabs-panel {
	border: solid 2px #E6E6E6;
	padding: 20px 15px !important;
}

.blog-recent .meta-category, .blog-recent .post-meta,
.single #single-below-header .meta-author.vcard.author,
.archive #single-below-header .meta-author.vcard.author,
.single-post #single-meta,
.nectar-love-wrap,
.meta-author,
.meta-category,
body .posts-container article .bottom-line{
	display: none;
}

.single-post .meta-date{
	border: none !important;
	padding-left: 0 !important;
	/* border: none !important; */
}

body[data-ext-responsive="true"].single-post .container-wrap.no-sidebar .post-area {
	margin: 0 !important;
}

#footer-widgets {font-size: 12px; line-height: 14px;}

#footer-widgets a {color: #b5b5b5;}
#footer-outer #footer-widgets a:hover {color: #ffffff !important;}
#footer-widgets p {padding-bottom: 12px;}

#footer-outer #footer-widgets .widget {
  margin-bottom: 0;
}

.entire-meta-link {
	pointer-events: none;
}

.wpb_content_element ol .nectar-button {
	/* color: red !important; */
	margin-top: 15px;
}

.container.main-content .blog-recent[data-style*="classic_enhanced"] .inner-wrap {
	padding: 0 !important;
}

.wpcf7-form-control-wrap .g-recaptcha {
	padding-top: 20px;
}

body .no-margin-bottom {
	margin-bottom: 0;
}

body .nectar-icon-list-item {
	margin-bottom: 15px;
}

body .col .ms-icon-box .wpb_wrapper {
	position: inherit;
}

.mobile .ms-icon-box .wpb_wrapper {
	position: relative !important;
}

.mobile .wpb_wrapper .ms-button {
	position: inherit;
}

.mobile .ms-icon-box .vc_column-inner {
	padding-bottom: 0;
}

.mobile .ms-icon-box .column_container {
	padding: 30px !important;
}

.link-description p {
	color: #bbbbbb;
	font-size: 0.8em;
	line-height: 1.1;
	padding-top: 8px;
}

body .link-description a {
	color: #999;
}

.team-button {
	background-color: #bbbbbb;
	color: #ffffff;
	padding: 5px 10px;
	margin-left: 10px;
	border-radius: 3px;
}
.team-button:hover {
	color: #ffffff;
	background: #305da8;
}

body nav .current-menu-parent a {
	background: #597eb9;
}

body .masonry-blog-item .inner-wrap {
	-o-box-shadow: none;
	-moz-box-shadow: none;
	-webkit-box-shadow: none;	
	box-shadow: none;
	border: solid 1px #305da8;
	border-radius: 3px;
}
body article.post .more-link span {
	background-color: #305da8;
	text-transform: uppercase;
	font-weight: bold;
	letter-spacing: 1.3px;
	font-size: 12px;
	padding: 8px 14px;
}
body article.post .more-link .continue-reading:hover {
	opacity: 0.87;
}
body article.post .content-inner {
	border-bottom: 1px solid rgba(48,93,168,0.5);
}
body[data-footer-reveal="1"][data-footer-reveal-shadow="large"] .container-wrap {
	box-shadow: 0 27px 25px -2px rgba(0,0,0,0.07)  !important;
	-webkit-box-shadow: 0 27px 25px -2px rgba(0,0,0,0.07) !important;
	-moz-box-shadow: 0 27px 25px -2px rgba(0,0,0,0.07) !important;
}
#footer-widgets .col_last {
	border-left: 2px dotted #305da8;
	padding-left: 15px;
}
#footer-outer #footer-widgets p a:hover {
	color: #305da8 !important;
	text-decoration: underline;
}
body article.post .post-header h2 a:hover {
	color: #6e8dc2 !important;
}
.ms-3er-blog .post-area {
	margin-bottom: 0;
}
.ms-3er-blog .meta-category {
	display: block;
	color: #ffffff;
	margin-top: 10px;
}
.ms-3er-blog .meta-category a {
	background: #305da8;
	padding: 5px 10px;
	border-radius: 3px;
	text-transform: uppercase;
	font-weight: bold;
	transition: all 0.5s;
}
body .ms-3er-blog .meta-category a:hover {
	color: #fff !important;
	opacity: 0.8;
}
.archive .subheader::before {
	content: "Archive ";
	visibility: visible;
}
.archive .subheader {
	visibility: hidden;
}
body.single article.post .content-inner {
	border-bottom: none;
	margin-bottom: 0;
}
.download-text p {
	color: #aaa;
	font-size: 0.7em;
	margin-top: -13px;
}
@media only screen and (min-width:1000px) {
.mobile-navi {
  display: none;
}
}
.mobile-navi a {
	font-size: 32px !important;
	line-height: 2em !important;
	text-transform: uppercase;
}


nav .menu-item-over a {
  background: #597eb9;
  transition: all 0.9s;
}

body #header-outer[data-lhe="default"] #top nav > ul > li > a {
	padding: 12px 20px;
  margin-left: 5px;
}

nav .sf-menu > li ul {
	padding: 0;
}
body #top nav > ul > li > ul > li {
	transform: none;
}
nav .sub-menu li a {
	padding: 15px;
}
