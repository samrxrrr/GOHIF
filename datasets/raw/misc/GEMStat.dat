	<div  class="vc_col-sm-3 wpb_column column_container vc_column_container col padding-1-percent inherit_tablet inherit_phone flex_gap_desktop_10px "  data-border-radius="3px" data-border-animation="" data-border-animation-delay="" data-border-width="1px" data-border-style="solid" data-border-color="#305da8" data-padding-pos="all" data-has-bg-color="false" data-bg-color="" data-bg-opacity="1" data-animation="" data-delay="0" >
