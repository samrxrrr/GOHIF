/* ==========================================================
   Linked Data Service Cards
   WordPress image block class: linked-data-service-card
   ========================================================== */

.wp-block-image.linked-data-service-card {
	position: relative;
	box-sizing: border-box;
	width: 100%;
	margin: 0;
	padding: clamp(1.25rem, 2.5vw, 2rem);
	background: #FFFFFF;
	border: 1px solid #E1E8F0;
	border-radius: 28px;
	box-shadow:
		0 3px 8px rgba(13, 37, 69, 0.05),
		0 14px 30px rgba(13, 37, 69, 0.10);
	overflow: hidden;
	cursor: pointer;
	transition:
		transform 0.25s ease,
		box-shadow 0.25s ease,
		border-color 0.25s ease;
}

/* Link uses the complete card area */
.wp-block-image.linked-data-service-card > a {
	display: block;
	text-decoration: none;
	background: #FFFFFF;
}

/* Image remains centred and clean */
.wp-block-image.linked-data-service-card img {
	display: block;
	width: 100%;
	height: auto;
	margin: 0 auto;
	background: #FFFFFF;
	border-radius: 16px;
	transition: transform 0.3s ease;
}

/* Optional HTML caption below the image */
.wp-block-image.linked-data-service-card figcaption {
	margin: 1.1rem 0 0.25rem;
	color: #102B52;
	font-size: clamp(1.05rem, 1.5vw, 1.3rem);
	font-weight: 650;
	line-height: 1.3;
	text-align: center;
}

/* Small visual cue that the card is clickable */
.wp-block-image.linked-data-service-card::after {
	content: "→";
	position: absolute;
	right: 1.15rem;
	bottom: 1.05rem;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 2.15rem;
	height: 2.15rem;
	color: #1767C9;
	font-size: 1.25rem;
	font-weight: 600;
	background: #FFFFFF;
	border: 1px solid #D8E5F5;
	border-radius: 50%;
	opacity: 0;
	transform: translateX(-6px);
	transition:
		opacity 0.22s ease,
		transform 0.22s ease,
		background-color 0.22s ease,
		color 0.22s ease;
	pointer-events: none;
}

/* Hover effect */
.wp-block-image.linked-data-service-card:hover {
	transform: translateY(-7px);
	border-color: #1767C9;
	box-shadow:
		0 6px 14px rgba(13, 37, 69, 0.08),
		0 26px 48px rgba(13, 37, 69, 0.17);
}

.wp-block-image.linked-data-service-card:hover img {
	transform: scale(1.018);
}

.wp-block-image.linked-data-service-card:hover::after {
	opacity: 1;
	transform: translateX(0);
	background-color: #1767C9;
	color: #FFFFFF;
}

/* Keyboard accessibility */
.wp-block-image.linked-data-service-card:focus-within {
	transform: translateY(-5px);
	border-color: #1767C9;
	box-shadow:
		0 0 0 3px rgba(23, 103, 201, 0.17),
		0 22px 42px rgba(13, 37, 69, 0.14);
}

.wp-block-image.linked-data-service-card:focus-within::after {
	opacity: 1;
	transform: translateX(0);
	background-color: #1767C9;
	color: #FFFFFF;
}

/* Equal-height cards in the two-column start area */
.wp-block-columns.linked-data-service-card-row {
	align-items: stretch;
	gap: clamp(1.5rem, 3vw, 2.75rem);
}

.wp-block-columns.linked-data-service-card-row > .wp-block-column {
	display: flex;
}

.wp-block-columns.linked-data-service-card-row .linked-data-service-card {
	display: flex;
	flex-direction: column;
	justify-content: center;
	height: 100%;
}

/* Mobile layout */
@media (max-width: 781px) {
	.wp-block-image.linked-data-service-card {
		padding: 1.1rem;
		border-radius: 22px;
	}

	.wp-block-image.linked-data-service-card::after {
		right: 0.8rem;
		bottom: 0.8rem;
	}
}

/* Accessibility: reduce animation when requested */
@media (prefers-reduced-motion: reduce) {
	.wp-block-image.linked-data-service-card,
	.wp-block-image.linked-data-service-card img,
	.wp-block-image.linked-data-service-card::after {
		transition: none;
	}

	.wp-block-image.linked-data-service-card:hover,
	.wp-block-image.linked-data-service-card:focus-within {
		transform: none;
	}

	.wp-block-image.linked-data-service-card:hover img {
		transform: none;
	}
}

/* ==========================================================
   RDF4RiskAssessment / KIDA Data Hub action buttons
   ========================================================== */

.kida-service-actions {
	display: flex;
	justify-content: center;
	align-items: stretch;
	gap: clamp(1rem, 2vw, 1.5rem);
	margin: 2.5rem auto 3rem;
	max-width: 820px;
}

.kida-action-button {
	box-sizing: border-box;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.8rem;
	min-height: 64px;
	padding: 1rem 1.6rem;
	border-radius: 999px;
	font-family: inherit;
	font-size: 1.4rem; /* increase button text size here */
	font-weight: 700;
	line-height: 1.3;
	text-align: center;
	text-decoration: none !important;
	transition:
		transform 0.2s ease,
		box-shadow 0.2s ease,
		background-color 0.2s ease,
		border-color 0.2s ease,
		color 0.2s ease;
}

/* GitHub: secondary action */
.kida-action-button--secondary {
	flex: 1 1 320px;
	color: #142D51;
	background-color: #FFFFFF;
	border: 1.5px solid #D3DCE8;
	box-shadow: 0 2px 7px rgba(15, 39, 71, 0.05);
}

.kida-action-button--secondary:hover {
	color: #142D51;
	background-color: #F7FAFE;
	border-color: #9CB5D5;
	transform: translateY(-3px);
	box-shadow: 0 10px 22px rgba(15, 39, 71, 0.12);
}

/* Data Hub: primary action */
.kida-action-button--primary {
	flex: 1 1 360px;
	color: #FFFFFF;
	background-color: #192F50;
	border: 1.5px solid #192F50;
	box-shadow: 0 4px 12px rgba(15, 39, 71, 0.16);
}

.kida-action-button--primary:hover {
	color: #FFFFFF;
	background-color: #1265C5;
	border-color: #1265C5;
	transform: translateY(-3px);
	box-shadow: 0 12px 25px rgba(18, 101, 197, 0.22);
}

/* Uploaded GitHub logo */
.kida-action-icon {
	display: block;
	flex: 0 0 auto;
	width: 28px;
	height: 28px;
	object-fit: contain;
	background: transparent;
}

/* Arrow on primary action */
.kida-action-arrow {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	font-size: 1.25rem;
	line-height: 1;
	transition: transform 0.2s ease;
}

.kida-action-button--primary:hover .kida-action-arrow {
	transform: translateX(4px);
}

/* Keyboard navigation */
.kida-action-button:focus-visible {
	outline: 3px solid rgba(18, 101, 197, 0.28);
	outline-offset: 3px;
}

/* Mobile layout */
@media (max-width: 680px) {
	.kida-service-actions {
		flex-direction: column;
		align-items: stretch;
	}

	.kida-action-button {
		flex-basis: auto;
		width: 100%;
	}
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
	.kida-action-button,
	.kida-action-arrow {
		transition: none;
	}

	.kida-action-button:hover {
		transform: none;
	}
}

/* Arrow direction for the back-navigation button */
.kida-action-button--secondary:hover .kida-action-arrow--back {
	transform: translateX(-4px);
}

/* Equal title area above both service cards */
.kida-service-card-title {
	display: flex;
	align-items: flex-start;
	justify-content: center;
	min-height: 2.6em;
	margin-top: 0;
	margin-bottom: 1.25rem;
	line-height: 1.3;
	text-align: center;
}

/* Remove additional top spacing from the card below the title */
.kida-service-card-title + .wp-block-image.linked-data-service-card {
	margin-top: 0;
}

/* On mobile, the cards are stacked and equal title height is unnecessary */
@media (max-width: 781px) {
	.kida-service-card-title {
		min-height: auto;
	}
}		</style>
		</head>

