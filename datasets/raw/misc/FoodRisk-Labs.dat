<article id="post-24" class="post-24 page type-page status-publish hentry">
	
	<header class="entry-header">
			</header><!-- .entry-header -->

	<div class="entry-content">
		<p><img decoding="async" class="aligncenter wp-image-1243 size-full" src="https://foodrisklabs.bfr.bund.de/wp-content/uploads/2017/12/FoodRiskLabsLogo1.gif" alt="FoodRiskLabsLogo1" width="624" height="90" /></p>
<p style="text-align: center;">FoodRisk-Labs is a portal to the following tools developed by the</p>
<p style="text-align: center;"><a href="http://www.bfr.bund.de/en/home.html" target="_blank" rel="noopener noreferrer">German Federal Institute for Risk Assessment (BfR)</a>:</p>
<table style="width: 100%; height: 965px;">
<tbody>
<tr style="height: 357px;">
<td style="height: 357px; width: 28.2609%;"><a href="https://foodrisklabs.bfr.bund.de/index.php/foodchain-lab/"><img decoding="async" class="aligncenter size-thumbnail wp-image-1269" src="https://foodrisklabs.bfr.bund.de/wp-content/uploads/2017/12/FoodChain-Lab-Logo_150.gif" alt="FoodChain-Lab Logo" width="150" height="150" /></a></p>
<p style="text-align: center;">Tracing food back and forward along food supply chains</p>
</td>
<td style="height: 357px; width: 31.7391%; text-align: center;"><a href="https://knime.bfr.berlin/landingpage/RAKIP-Model-Repository"><img loading="lazy" decoding="async" class="aligncenter" src="https://foodrisklabs.bfr.bund.de/wp-content/uploads/2024/10/RAKIP_web_repository_1200x1200-1.png" alt="" width="151" height="151" /></a><a href="https://knime.bfr.berlin/landingpage/RAKIP-Model-Repository">RAKIP-Web Model Repository</a></td>
<td style="height: 357px; width: 40%; text-align: center;"><a href="https://foodrisklabs.bfr.bund.de/rakip-initiative/"><img loading="lazy" decoding="async" class="aligncenter" src="https://foodrisklabs.bfr.bund.de/wp-content/uploads/2023/05/RAKIP_Logo_150x150.png" alt="" width="254" height="254" /></a><a href="https://foodrisklabs.bfr.bund.de/rakip-initiative/">RAKIP Initiative</a></td>
</tr>
<tr style="height: 385px;">
<td style="text-align: center; height: 385px; width: 28.2609%;"><a href="https://foodrisklabs.bfr.bund.de/fsk-ml-food-safety-knowledge-markup-language/"><img decoding="async" class="aligncenter" src="https://foodrisklabs.bfr.bund.de/wp-content/uploads/2023/05/FSKX.png" />FSKX </a><a href="https://foodrisklabs.bfr.bund.de/fskx-food-safety-knowledge-exchange-format/">(Food Safety Knowledge Exchange) Format</a></td>
<td style="height: 385px; width: 31.7391%;">
<p style="text-align: center;"><a href="https://foodrisklabs.bfr.bund.de/index.php/fsk-lab/"><img loading="lazy" decoding="async" class="aligncenter wp-image-1866 size-full" src="https://foodrisklabs.bfr.bund.de/wp-content/uploads/2015/02/FSKlab7-1.png" alt="FSK-Lab" width="150" height="150" /></a>Food Safety Knowledge Lab (FSK-Lab)</p>
</td>
